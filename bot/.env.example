# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Username админа для уведомлений (без @)
ADMIN_USERNAME=neradana

# Chat ID админа (опционально; иначе сохранится после /start от @neradana)
ADMIN_CHAT_ID=

# Режим: polling (локально) или webhook (продакшен)
BOT_MODE=polling

# Для webhook: публичный URL сервера, например https://bot.example.com
WEBHOOK_URL=

# Секретный путь webhook (произвольная строка)
WEBHOOK_SECRET=change-me-to-random-string

# Порт HTTP-сервера (API + webhook)
PORT=8080

# CORS: через запятую, без пробелов
ALLOWED_ORIGINS=https://koolesoo.github.io,http://localhost:8080,http://127.0.0.1:8080
