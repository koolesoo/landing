# Токен основного бота от @BotFather (grow_career_bot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=grow_career_bot

# Админ-бот для уведомлений (@career67_bot)
ADMIN_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_BOT_USERNAME=career67_bot

# Кому разрешён доступ к админ-боту (username без @, через запятую)
ALLOWED_ADMIN_USERNAMES=neradana,koolesoo

# Опционально: chat id админов через запятую (если уже известны)
ADMIN_CHAT_IDS=

# Режим: polling (локально/VPS) или webhook (продакшен с доменом)
BOT_MODE=polling

# SOCKS5/HTTP прокси до api.telegram.org (нужен на VPS в РФ, если Telegram блокируется)
# Пример: socks5://user:pass@host:1080  или  http://127.0.0.1:1080
TELEGRAM_PROXY=

# На VPS в polling-схеме слушаем только localhost (не открываем порт наружу)
HOST=127.0.0.1

# Для webhook: публичный URL сервера, например https://bot.example.com
WEBHOOK_URL=

# Секретный путь webhook (случайная строка, минимум 24 символа)
WEBHOOK_SECRET=change-me-to-random-string

# Порт HTTP-сервера (health, webhook)
PORT=8090

# CORS: через запятую, без пробелов
ALLOWED_ORIGINS=https://growcareer.ru,https://www.growcareer.ru
